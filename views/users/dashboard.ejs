<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <style>
        body{
            padding-left: 10px;
        }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <h1>Hello <%= username %></h1>
    <h5>Welcome to the dashboard</h5>
    <a href="/"><button type="button" class="btn btn-dark">Homepage</button></a>
    <a href="/users/logout"><button type="button" class="btn btn-secondary">Logout</button></a>
    <hr>
    <h3>Create domain</h3>
    <form action="/users/domains" method="post">
        <div class="input-group mb-3 w-100 w-md-25">
            <span class="input-group-text">Domain name</span>
            <input type="text" name="domain" class="form-control" required>
        </div>

        <div class="input-group mb-3 w-100 w-md-25">
            <span class="input-group-text">Server's ip</span>
            <input type="text" name="ip" class="form-control" required>
        </div>
        <br>
        <input type="submit" value="Create domain" type="button" class="btn btn-success">
    </form>
    <br>

    <h3>Delete domain</h3>
    <form id="deleteForm">
        <div class="input-group mb-3 w-100 w-md-25">
            <span class="input-group-text">Domain name</span>
            <input type="text" id="deleteDomain" class="form-control" required>
        </div>
        <br>
        <button type="button" class="btn btn-danger" id="submitDelete">Delete domain</button>
    </form>
    <p id="deleteResult"></p>

    <p id="domains">Domains: loading...</p>

    <script>
        const deleteForm = document.getElementById("deleteForm");
        const deleteDomain = document.getElementById("deleteDomain");
        const deleteSubmit = document.getElementById("submitDelete");
        const deleteResult = document.getElementById("deleteResult");
        const username = "<%= username %>"
        const domainsText = document.getElementById("domains");

        deleteSubmit.addEventListener("click", async (e) => {
            // prevent the form's default submit behavior just in case
            e.preventDefault();

            if(deleteForm.checkValidity()){
                const result = await fetch("/users/domains", {
                    method: "DELETE",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        domain: deleteDomain.value
                    })
                });
                const resultJson = await result.json();
                if(result.ok){
                    deleteResult.textContent = "Deleted domain"
                }
                else{
                    deleteResult.textContent = `There was an error while deleting your domain`;
                }
            }
            else{
                // use the form element variable to report validity
                deleteForm.reportValidity();
            }
        });

        async function updateDomains() {
            const response = await fetch(`/users/domains/${username}`);
            const responseJson = await response.json();
            if(response.ok){
                domainsText.textContent = `Domains: ${responseJson.domains}`;
            }
            else{
                domainsText.textContent = "Domains: No domains";
            }
        }

        updateDomains();
    </script>
</body>
</html>